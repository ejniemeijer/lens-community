# ──────────────────────────────────────────────────────────────────────────
# Lens — environment variables
#
# Copy to `.env.local` for local development, or set these in your host
# (e.g. Coolify → Environment). WITHOUT the Supabase vars the app runs in a
# local, in-memory prototype mode (sample data, nothing persists). Set them to
# run the real, multi-tenant, persistent app.
#
# NEXT_PUBLIC_* values are exposed to the browser — never put secrets there.
# See docs/deployment.md for the full step-by-step.
# ──────────────────────────────────────────────────────────────────────────

# ── Edition ─────────────────────────────────────────────────────────────────
# The community build runs as the self-hosted edition (single workspace,
# no trials or seat caps, operator console disabled).
NEXT_PUBLIC_DEPLOYMENT_MODE=self-hosted

# ── Supabase — REQUIRED for the real app ────────────────────────────────────
# From Supabase → Project Settings → API. Use an EU-region project for EU data residency.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Bypasses row-level security — NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Encryption — REQUIRED to store workspace AI keys ────────────────────────
# 32+ random characters. Encrypts each workspace's shared AI API keys at rest
# (AES-256-GCM). Generate one with:  openssl rand -base64 32
# NOTE: if you change this later, previously-saved AI keys can't be decrypted
# (admins simply re-enter them). Keep it stable and secret.
AI_KEY_SECRET=change-me-to-a-long-random-string

# ── Public app URL — recommended ────────────────────────────────────────────
# Your deployment's public URL. Used in welcome-email text and absolute links.
NEXT_PUBLIC_APP_URL=https://lens.example.com

# ── AI provider fallback keys — optional ────────────────────────────────────
# Workspace keys entered in-app (Settings → AI) are preferred; these are an
# optional server-wide fallback so AI works before a workspace configures one.
# ANTHROPIC_API_KEY=sk-ant-your-key-here   # Claude  — console.anthropic.com
# OPENAI_API_KEY=sk-your-key-here          # OpenAI  — platform.openai.com/api-keys
# XAI_API_KEY=xai-your-key-here            # Grok    — console.x.ai
# GEMINI_API_KEY=your-key-here             # Gemini  — aistudio.google.com/apikey

# ── Demo sandbox — optional ─────────────────────────────────────────────────
# Password for the bundled sample/seed users. Change it in any real deployment.
# NEXT_PUBLIC_DEMO_PASSWORD=changeme
